### Layer 5: Controllers

Each controller file contains the actual `async (req, res)` handler functions extracted from `index.js`. Controllers are the **only** layer that reads `req.*` and writes `res.*`.

**Example pattern:**
```js
// controllers/agents.controller.js
import { pool } from '../db/postgres.js';
import { agentFilters } from '../lib/agentFilters.js';
import { enrichAgentRow } from '../services/agentDepth.js';

export async function list(req, res) {
  const tenantId = req.tenantId;
  const { clauses, params } = agentFilters(req.query);
  // ... SQL query
  res.json({ agents: rows, total });
}

export async function getById(req, res) { ... }
export async function anatomy(req, res) { ... }
```

