              <input id="cd-copilot-client" placeholder="Client ID (App Registration)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <input id="cd-copilot-secret" type="password" placeholder="Client Secret" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <div style="font-size:10px;color:var(--text-muted)">Needs: BotFramework · PowerApps API</div>
            </div>
          </div>
          <!-- Salesforce -->
          <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
              <div style="width:28px;height:28px;background:rgba(0,161,224,0.1);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px">☁️</div>
              <div style="flex:1"><div style="font-size:12px;font-weight:700">Salesforce</div><div style="font-size:10px;color:var(--text-muted)">Agentforce · Einstein AI</div></div>
