            <div style="display:flex;flex-direction:column;gap:5px">
              <input id="cd-workday-tenant" placeholder="Tenant URL (e.g. https://wd3.myworkday.com/myco)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <input id="cd-workday-client" placeholder="Client ID (OAuth2)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <input id="cd-workday-secret" type="password" placeholder="Client Secret" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
