          <div style="display:flex;flex-direction:column;gap:5px">
            <input id="cd-cs-key" placeholder="Client ID" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <input id="cd-cs-secret" type="password" placeholder="Client Secret" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <select id="cd-cs-region" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%">
              <option value="https://api.crowdstrike.com">US-1 (default)</option>
              <option value="https://api.us-2.crowdstrike.com">US-2</option>
              <option value="https://api.eu-1.crowdstrike.com">EU-1</option>
              <option value="https://api.laggar.gcw.crowdstrike.com">GOV</option>
            </select>
          </div>
        </div>

        <!-- Proxy / CASB -->
        <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
            <div style="width:28px;height:28px;background:rgba(16,185,129,0.1);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px">🌐</div>
            <div style="flex:1"><div style="font-size:12px;font-weight:700">Proxy / CASB Logs</div>
            <div style="font-size:10px;color:var(--text-muted)">Zscaler · Bluecoat</div></div>
            <div id="cd-proxy-status" style="font-size:10px;padding:2px 6px;border-radius:10px;background:var(--bg-secondary);color:var(--text-muted)">Off</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:5px">
            <select id="cd-proxy-type" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%">
              <option value="">Select proxy type...</option>
              <option value="zscaler">Zscaler ZIA</option>
              <option value="bluecoat">Bluecoat / Symantec</option>
              <option value="generic">Generic (CSV/JSON)</option>
            </select>
            <textarea id="cd-proxy-logs" placeholder='Paste proxy logs (JSON array) or upload file&#10;[{"url":"https://api.openai.com","user":"john@co.com","device":"PC-001"}]' style="font-size:10px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box;resize:vertical;min-height:60px;font-family:monospace"></textarea>
            <button onclick="exportZscalerConfig()" style="font-size:10px;padding:4px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-secondary);cursor:pointer;color:var(--text-primary)">📥 Export Zscaler Policy</button>
          </div>
        </div>

        <!-- Intune + Netskope row -->
        <div class="g2">

        <!-- Microsoft Intune -->
        <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
            <div style="width:28px;height:28px;background:rgba(0,120,212,0.1);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px">💻</div>
            <div style="flex:1"><div style="font-size:12px;font-weight:700">Microsoft Intune</div>
            <div style="font-size:10px;color:var(--text-muted)">AI apps on managed devices</div></div>
            <div id="cd-intune-status" style="font-size:10px;padding:2px 6px;border-radius:10px;background:var(--bg-secondary);color:var(--text-muted)">Off</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:5px">
            <input id="cd-intune-tenant" placeholder="Tenant ID" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <input id="cd-intune-client" placeholder="Client ID (App Registration)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <input id="cd-intune-secret" type="password" placeholder="Client Secret" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <div style="font-size:10px;color:var(--text-muted)">Needs: DeviceManagementApps.Read.All</div>
          </div>
        </div>

        <!-- Netskope -->
        <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#00b4d8,#0077b6);display:flex;align-items:center;justify-content:center;font-size:16px">🔒</div>
            <div style="flex:1"><div style="font-size:12px;font-weight:700">Netskope</div><div style="font-size:10px;color:var(--text-muted)">CASB · SSE · AI Traffic Discovery</div></div>
            <div id="cd-netskope-status" style="font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;background:var(--bg-secondary);color:var(--text-muted)">Off</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:6px">
            <input id="cd-netskope-tenant" placeholder="Tenant Name (e.g. mycompany)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <input id="cd-netskope-token" type="password" placeholder="API Token (v2)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
            <div style="display:flex;gap:6px;margin-top:2px">
              <button onclick="saveNetskopeConn()" style="flex:1;padding:6px;border-radius:6px;border:none;background:var(--accent-primary);color:#fff;font-size:11px;font-weight:600;cursor:pointer">Connect</button>
              <button onclick="scanNetskope()" style="flex:1;padding:6px;border-radius:6px;border:1px solid var(--glass-border-dim);background:transparent;color:var(--text-primary);font-size:11px;cursor:pointer">⟳ Scan AI Traffic</button>
            </div>
          </div>
        </div>

        </div><!-- end intune+netskope grid -->

    <!-- Single action button -->
    <div style="display:flex;gap:10px;align-items:center">
      <button onclick="startFullDiscovery()" id="cd-scan-btn"
        style="background:linear-gradient(135deg,#2563eb,#7c3aed);color:white;border:none;border-radius:10px;padding:12px 28px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;transition:opacity .15s">
        ⚡ Discover All AI Agents
      </button>
      <button onclick="cdSaveOnly()" style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:10px;padding:12px 20px;font-size:13px;cursor:pointer;color:var(--text-primary)">
        💾 Save Credentials Only
      </button>
      <div id="cd-progress" style="font-size:12px;color:var(--text-muted);display:none">
        <span id="cd-progress-msg">Scanning...</span>
      </div>
    </div>

    <!-- Results panel -->
    <div id="cd-results" style="display:none;margin-top:16px;background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:16px">
      <div style="font-size:13px;font-weight:700;margin-bottom:10px">Discovery Results</div>
      <div id="cd-results-body"></div>
    </div>

    <!-- Advanced settings toggle -->
    <div style="margin-top:12px">
      <button onclick="document.getElementById('cd-advanced').style.display=document.getElementById('cd-advanced').style.display==='none'?'block':'none'"
        style="background:none;border:none;font-size:12px;color:var(--text-muted);cursor:pointer;padding:0">
        ▸ Advanced scanner configuration
      </button>
      <div id="cd-advanced" style="display:none;margin-top:10px;padding:12px;background:var(--bg-secondary);border-radius:8px;font-size:12px;color:var(--text-muted)">
        Advanced options are auto-configured based on your environment. Manual scanner configuration is available below if needed.
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div style="border-top:1px solid var(--glass-border-dim);margin:0 24px 20px"></div>

  <!-- Legacy manual tabs (collapsed by default) -->
  <div style="padding:0 24px">
    <button onclick="document.getElementById('legacy-integ').style.display=document.getElementById('legacy-integ').style.display==='none'?'block':'none'"
      style="background:none;border:none;font-size:12px;color:var(--text-muted);cursor:pointer;padding:0;margin-bottom:12px">
      ▸ Manual scanner configuration (advanced)
    </button>
    <div id="legacy-integ" style="display:none">
      <!-- Status bar -->
      <div class="env-status-bar" id="env-status-bar">
        <div class="esb-item"><div class="esb-dot" style="background:var(--green)"></div><span class="esb-label">Cloud scan</span><span class="esb-val" id="esb-cloud">Offline</span></div>
        <div class="esb-divider"></div>
        <div class="esb-item"><div class="esb-dot" style="background:var(--amber)" id="esb-sensor-dot"></div><span class="esb-label">On-prem sensor</span><span class="esb-val" id="esb-sensor">Not deployed</span></div>
        <div class="esb-divider"></div>
        <div class="esb-item"><div class="esb-dot" style="background:var(--purple)" id="esb-siem-dot"></div><span class="esb-label">SIEM</span><span class="esb-val" id="esb-siem">Disconnected</span></div>
        <div class="esb-divider"></div>
        <div class="esb-item"><div class="esb-dot" style="background:var(--blue)" id="esb-cicd-dot"></div><span class="esb-label">CI/CD gate</span><span class="esb-val" id="esb-cicd">Not configured</span></div>
        <div class="esb-divider"></div>
        <div class="esb-item"><div class="esb-dot" style="background:#38bdf8" id="esb-hc-dot"></div><span class="esb-label">Healthcare</span><span class="esb-val" id="esb-hc">2 connected</span></div>
        <div style="margin-left:auto;display:flex;gap:8px">
          <button class="btn sm" onclick="showSetupWizard()">+ Connect Environment</button>
          <button class="btn sm primary" onclick="runFullEnvScan()">⟳ Full Environment Scan</button>
          <button class="btn sm ai" onclick="openCodePanel()">⟨/⟩ Code Editor</button>
        </div>
      </div>

      <!-- Environment health grid -->
      <div class="env-health-grid" id="env-health-grid">
        <div class="env-health-card"><div class="ehc-icon">☁</div><div class="ehc-name">Cloud API</div><div class="ehc-status" id="ehc-cloud" style="color:var(--text-muted)">Not connected</div><div class="ehc-count" id="ehc-cloud-c">0 environments</div></div>
        <div class="env-health-card"><div class="ehc-icon">🏢</div><div class="ehc-name">On-Prem Sensor</div><div class="ehc-status" id="ehc-sensor" style="color:var(--text-muted)">Not deployed</div><div class="ehc-count" id="ehc-sensor-c">0 subnets</div></div>
        <div class="env-health-card"><div class="ehc-icon">📡</div><div class="ehc-name">SIEM / Logs</div><div class="ehc-status" id="ehc-siem" style="color:var(--text-muted)">Disconnected</div><div class="ehc-count" id="ehc-siem-c">0 indexes</div></div>
        <div class="env-health-card"><div class="ehc-icon">⚙</div><div class="ehc-name">CI/CD Gate</div><div class="ehc-status" id="ehc-cicd" style="color:var(--text-muted)">Not configured</div><div class="ehc-count" id="ehc-cicd-c">0 pipelines</div></div>
        <div class="env-health-card"><div class="ehc-icon">🏥</div><div class="ehc-name">Healthcare</div><div class="ehc-status" id="ehc-hc" style="color:var(--teal)">2 connected</div><div class="ehc-count" id="ehc-hc-c">Epic + Cerner FHIR</div></div>
      </div>

      <!-- Tabs -->
      <div class="env-tabs" id="env-tabs">
        <div class="env-tab on" onclick="showEnvTab('cloud')">☁ Cloud API</div>
        <div class="env-tab" onclick="showEnvTab('onprem')">🏢 On-Prem Sensor</div>
        <div class="env-tab" onclick="showEnvTab('siem')">📡 SIEM / Logs</div>
        <div class="env-tab" onclick="showEnvTab('cicd')">⚙ CI/CD Gate</div>
        <div class="env-tab hc" onclick="showEnvTab('health')">🏥 Healthcare</div>
        <div class="env-tab" onclick="showEnvTab('scripts')">⟨/⟩ Custom Scripts</div>
      </div>

      <!-- ── Cloud API ── -->
      <div class="env-pane on" id="envp-cloud">
        <div class="conn-grid">

          <!-- AWS -->
          <div class="conn-card" id="cc-aws">
            <div class="conn-head" onclick="toggleConn('cc-aws')">
              <div class="conn-icon" style="background:#fff3e0">🟠</div>
              <div>
                <div class="conn-name">Amazon Web Services</div>
                <div style="font-size:10px;color:var(--text-muted)">Lambda · SageMaker · Bedrock · ECS</div>
              </div>
              <span class="conn-status cs-idle" id="cs-aws">Not connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">IAM Role ARN</div><input class="cred-inp" id="ci-aws-arn" placeholder="arn:aws:iam::123456789:role/AgentRadar-Scanner"></div>
                <div class="cred-field"><div class="cred-lbl">External ID</div><input class="cred-inp" id="ci-aws-ext" placeholder="agentRadar-ext-xxxx"></div>
                <div class="cred-field"><div class="cred-lbl">Primary Region</div>
                  <select class="cred-select" id="ci-aws-region"><option>us-east-1</option><option>us-west-2</option><option>eu-west-1</option><option>eu-central-1</option><option>ap-southeast-1</option><option>ap-northeast-1</option></select>
                </div>
                <div class="cred-field full"><div class="cred-lbl">Additional Regions (comma-separated)</div><input class="cred-inp" id="ci-aws-regions" placeholder="us-west-2, eu-west-1, ap-southeast-1"></div>
                <div class="cred-field full"><div class="cred-lbl">Account IDs to scan (comma-separated)</div><input class="cred-inp" id="ci-aws-accounts" placeholder="123456789012, 987654321098"></div>
              </div>
              <div style="font-size:11px;color:var(--text-muted);margin-bottom:10px">Minimum IAM policy required:</div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># Paste this into IAM → Policies → Create policy</span>
{<span class="str">"Version"</span>:<span class="val">"2012-10-17"</span>,<span class="str">"Statement"</span>:[{
  <span class="str">"Effect"</span>:<span class="val">"Allow"</span>,<span class="str">"Action"</span>:[
    <span class="str">"lambda:ListFunctions"</span>,<span class="str">"lambda:GetFunction"</span>,
    <span class="str">"sagemaker:ListEndpoints"</span>,<span class="str">"sagemaker:DescribeEndpoint"</span>,
    <span class="str">"bedrock:ListFoundationModels"</span>,<span class="str">"ec2:DescribeInstances"</span>,
    <span class="str">"ecs:ListTasks"</span>,<span class="str">"logs:DescribeLogGroups"</span>
  ],<span class="str">"Resource"</span>:<span class="val">"*"</span>}]}</div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('aws')">▶ Test Connection</button>
                <button class="btn sm" onclick="saveConn('aws')">Save Credentials</button>
                <button class="btn sm" onclick="runCloudScan('aws')">⟳ Run Scan</button>
              </div>
              <div class="conn-log" id="log-aws"></div>
            </div>
          </div>

          <!-- Azure -->
          <div class="conn-card" id="cc-azure">
            <div class="conn-head" onclick="toggleConn('cc-azure')">
              <div class="conn-icon" style="background:#e3f2fd">🔷</div>
              <div>
                <div class="conn-name">Microsoft Azure</div>
                <div style="font-size:10px;color:var(--text-muted)">Azure OpenAI · ML Studio · Cognitive</div>
              </div>
              <span class="conn-status cs-connected" id="cs-azure">Connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field"><div class="cred-lbl">Tenant ID</div><input class="cred-inp" id="ci-az-tenant" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" value="a1b2c3d4-e5f6-7890-abcd-ef1234567890"></div>
                <div class="cred-field"><div class="cred-lbl">Client ID (App Registration)</div><input class="cred-inp" id="ci-az-client" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" value="d4e5f6a1-b2c3-4567-89ab-cdef01234567"></div>
                <div class="cred-field"><div class="cred-lbl">Client Secret</div><input class="cred-inp" id="ci-az-secret" type="password" placeholder="••••••••••••••••" value="set"></div>
                <div class="cred-field"><div class="cred-lbl">Subscription IDs</div><input class="cred-inp" id="ci-az-subs" placeholder="sub-id-1, sub-id-2"></div>
              </div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('azure')">▶ Test Connection</button>
                <button class="btn sm" onclick="saveConn('azure')">Save</button>
                <button class="btn sm" onclick="runCloudScan('azure')">⟳ Scan</button>
              </div>
              <div class="conn-log" id="log-azure"><div class="log-grn">[OK] Azure SP authenticated — 3 subscriptions visible</div><div class="log-grn">[OK] Azure OpenAI: 4 deployments found</div><div class="log-grn">[OK] ML Studio: 2 endpoints, 1 compute cluster</div></div>
            </div>
          </div>

          <!-- GCP -->
          <div class="conn-card" id="cc-gcp">
            <div class="conn-head" onclick="toggleConn('cc-gcp')">
              <div class="conn-icon" style="background:#e8f5e9">🟢</div>
              <div>
                <div class="conn-name">Google Cloud Platform</div>
                <div style="font-size:10px;color:var(--text-muted)">Vertex AI · Cloud Run · Cloud Functions</div>
              </div>
              <span class="conn-status cs-connected" id="cs-gcp">Connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">Service Account JSON Key</div><textarea class="cred-inp" id="ci-gcp-key" rows="3" placeholder='{"type":"service_account","project_id":"my-project",...}'></textarea></div>
                <div class="cred-field full"><div class="cred-lbl">Project IDs (comma-separated)</div><input class="cred-inp" id="ci-gcp-projects" placeholder="my-project-1, my-project-2" value="healthtech-prod, healthtech-dev"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># Grant read-only roles</span>
<span class="kw">for</span> role in roles/aiplatform.viewer roles/run.viewer \
             roles/logging.viewer roles/monitoring.viewer; do
  gcloud projects add-iam-policy-binding PROJECT_ID \
    --member=<span class="str">"serviceAccount:agentRadar@PROJECT.iam.gserviceaccount.com"</span> \
    --role=$role
done</div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('gcp')">▶ Test</button>
                <button class="btn sm" onclick="saveConn('gcp')">Save</button>
                <button class="btn sm" onclick="runCloudScan('gcp')">⟳ Scan</button>
              </div>
              <div class="conn-log" id="log-gcp"><div class="log-grn">[OK] GCP SA authenticated — 2 projects</div><div class="log-grn">[OK] Vertex AI: 3 model endpoints found</div></div>
            </div>
          </div>

          <!-- Kubernetes -->
          <div class="conn-card" id="cc-k8s">
            <div class="conn-head" onclick="toggleConn('cc-k8s')">
              <div class="conn-icon" style="background:#e8eeff">⎈</div>
              <div>
                <div class="conn-name">Kubernetes Clusters</div>
                <div style="font-size:10px;color:var(--text-muted)">EKS · AKS · GKE · Self-managed</div>
              </div>
              <span class="conn-status cs-idle" id="cs-k8s">Not connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">Kubeconfig (base64-encoded) or API Server URL</div><input class="cred-inp" id="ci-k8s-url" placeholder="https://kubernetes.example.com:6443"></div>
                <div class="cred-field"><div class="cred-lbl">Service Account Token</div><input class="cred-inp" id="ci-k8s-token" type="password" placeholder="eyJhbGciOiJSUzI1NiIs..."></div>
                <div class="cred-field"><div class="cred-lbl">Namespaces to scan</div><input class="cred-inp" id="ci-k8s-ns" placeholder="default, production, ai-workloads"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># Create read-only ClusterRole for AgentRadar</span>
kubectl apply -f - &lt;&lt;EOF
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: {name: agentRadar-viewer}
rules:
- apiGroups: [<span class="str">""</span>,<span class="str">"apps"</span>]
  resources: [<span class="str">"pods"</span>,<span class="str">"deployments"</span>,<span class="str">"services"</span>]
  verbs: [<span class="str">"get"</span>,<span class="str">"list"</span>]
EOF</div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('k8s')">▶ Test</button>
                <button class="btn sm" onclick="saveConn('k8s')">Save</button>
                <button class="btn sm" onclick="runCloudScan('k8s')">⟳ Scan</button>
              </div>
              <div class="conn-log" id="log-k8s"></div>
            </div>
          </div>

        </div>
      </div>

      <!-- ── IdP OAuth Scanner ── -->
      <div class="env-pane" id="envp-identity">
        <div class="conn-grid">
          <div class="conn-card" id="cc-idp">
            <div class="conn-card-head">
              <div class="conn-status cs-pending" id="cs-idp">Not connected</div>
              <div class="conn-card-title">OAuth / IdP Grant Scanner</div>
              <div class="conn-card-sub">Okta · Azure AD · Google Workspace</div>
            </div>
            <div class="conn-body">
              <div class="conn-desc">Scans your identity provider for OAuth grants to AI platforms. Finds hosted Claude agents, Copilot, Cursor, and any AI tool employees authorised without IT approval — even when the agent runs on vendor infrastructure.</div>
              <div class="conn-fields">
                <div class="field-row"><label class="field-lbl">Identity provider</label>
                  <select class="field-inp" id="ci-idp-type"><option value="okta">Okta</option><option value="azure">Azure AD</option><option value="google">Google Workspace</option></select>
                </div>
                <div class="field-row"><label class="field-lbl">Domain / Tenant ID</label><input class="field-inp" id="ci-idp-domain" placeholder="company.okta.com or azure-tenant-id"></div>
                <div class="field-row"><label class="field-lbl">API token / Secret</label><input class="field-inp" type="password" id="ci-idp-token" placeholder="SSWS token or client secret"></div>
              </div>
              <div class="conn-actions">
