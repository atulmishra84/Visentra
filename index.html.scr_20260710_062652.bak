                <div class="cred-field"><div class="cred-lbl">Ingest Endpoint</div><input class="cred-inp" id="ci-sensor-ep" value="ingest.agentRadar.io" readonly></div>
                <div class="cred-field full"><div class="cred-lbl">CIDR Ranges to Scan</div><input class="cred-inp" id="ci-sensor-cidr" placeholder="10.0.0.0/8, 192.168.0.0/16, 172.16.0.0/12"></div>
                <div class="cred-field full"><div class="cred-lbl">Ports to Scan</div><input class="cred-inp" id="ci-sensor-ports" value="80,443,8080,8443,8899,11434,2575,104,11112"></div>
                <div class="cred-field"><div class="cred-lbl">Healthcare Mode</div><select class="cred-select" id="ci-sensor-hc"><option value="true">Enabled (FHIR/HL7/DICOM)</option><option value="false">Disabled</option></select></div>
                <div class="cred-field"><div class="cred-lbl">Deploy Method</div><select class="cred-select" id="ci-sensor-method" onchange="updateSensorSnip()"><option value="docker">Docker</option><option value="helm">Kubernetes (Helm)</option><option value="systemd">systemd service</option></select></div>
              </div>
              <div id="sensor-snip">
                <div style="font-size:11px;color:var(--text-muted);margin:10px 0 6px">Install command:</div>
                <div class="code-snip" id="sensor-code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span id="sensor-cmd-text">docker run -d --name agentRadar-sensor \
  --restart unless-stopped --network host \
  -e <span class="kw">ENROLLMENT_TOKEN</span>=<span class="str">"tok_live_xxxxxxxxxxxx"</span> \
  -e <span class="kw">SCAN_RANGES</span>=<span class="str">"10.0.0.0/8,192.168.0.0/16"</span> \
  -e <span class="kw">SCAN_PORTS</span>=<span class="str">"80,443,8080,8443,8899,11434,2575,104"</span> \
  -e <span class="kw">HEALTHCARE_MODE</span>=<span class="str">"true"</span> \
  ghcr.io/agentRadar/sensor:<span class="val">latest</span></span></div>
              </div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="deploySensor()">▶ Deploy & Enroll</button>
                <button class="btn sm" onclick="testConn('sensor')">Test Connection</button>
                <button class="btn sm" onclick="copyEnrollToken()">Copy Enroll Token</button>
              </div>
              <div class="conn-log" id="log-sensor"></div>
