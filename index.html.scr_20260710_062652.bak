              <input id="cd-qradar-token" type="password" placeholder="SEC Token" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <button onclick="saveSIEM('qradar')" style="padding:6px;border-radius:6px;border:none;background:var(--accent-primary);color:#fff;font-size:11px;font-weight:600;cursor:pointer">Connect QRadar</button>
