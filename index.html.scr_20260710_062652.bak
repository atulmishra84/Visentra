      <!-- ══ ENDPOINT & IDENTITY ═══════════════════ -->
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin:14px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--glass-border-dim)">💻 Endpoint & Identity</div>
        <!-- Cortex XDR -->
