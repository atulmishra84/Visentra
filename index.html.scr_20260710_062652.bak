    </div>

    <!-- Endpoint & Proxy scanners -->
    <div style="margin-top:12px">
      <div style="font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">Endpoint & Traffic Scanners</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">

      <!-- ══ SAAS AI PLATFORMS ═══════════════════════ -->
      <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em;margin:14px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--glass-border-dim)">🤖 SaaS AI Platforms</div>
        <!-- SaaS AI Platforms row 1: Copilot Studio + Salesforce -->
        <div class="g2">
          <!-- Copilot Studio -->
