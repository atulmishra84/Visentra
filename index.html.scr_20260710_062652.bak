            </div>
            <div style="display:flex;flex-direction:column;gap:5px">
              <input id="cd-splunk-url" placeholder="HEC URL (https://splunk:8088)" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <input id="cd-splunk-token" type="password" placeholder="HEC Token" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <button onclick="saveSIEM('splunk')" style="padding:6px;border-radius:6px;border:none;background:var(--accent-primary);color:#fff;font-size:11px;font-weight:600;cursor:pointer">Connect Splunk</button>
            </div>
          </div>
          <!-- Microsoft Sentinel -->
          <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
              <div style="width:28px;height:28px;background:rgba(0,120,212,0.1);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px">🛡️</div>
