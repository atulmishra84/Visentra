      <!-- ── CI/CD ── -->
      <div class="env-pane" id="envp-cicd">
        <div class="conn-grid">
          <div class="conn-card" id="cc-github">
            <div class="conn-head" onclick="toggleConn('cc-github')">
              <div class="conn-icon" style="background:#f5f5f5">🐙</div>
              <div><div class="conn-name">GitHub Actions</div><div style="font-size:10px;color:var(--text-muted)">Policy gate · PR checks · Manifest validation</div></div>
              <span class="conn-status cs-idle" id="cs-github">Not configured</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field"><div class="cred-lbl">GitHub Organization</div><input class="cred-inp" id="ci-gh-org" placeholder="my-org"></div>
                <div class="cred-field"><div class="cred-lbl">Personal Access Token or App ID</div><input class="cred-inp" id="ci-gh-token" type="password" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"></div>
                <div class="cred-field full"><div class="cred-lbl">Target Repositories (comma-separated, or * for all)</div><input class="cred-inp" id="ci-gh-repos" placeholder="ai-service, ml-pipeline, clinical-classifier, *"></div>
                <div class="cred-field"><div class="cred-lbl">Block on severity</div><select class="cred-select" id="ci-gh-block"><option>critical only</option><option selected>critical, high</option><option>critical, high, medium</option></select></div>
                <div class="cred-field"><div class="cred-lbl">Frameworks to enforce</div><input class="cred-inp" id="ci-gh-fw" value="gdpr, hipaa, euai, soc2" placeholder="gdpr, hipaa, soc2"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># .github/workflows/agentRadar-gate.yml</span>
- name: <span class="str">AgentRadar AI governance gate</span>
  uses: <span class="val">agentRadar/scan-action@v2</span>
  with:
    api-key: <span class="kw">${{ secrets.AGENTRADARPOLICY_KEY }}</span>
    fail-on: <span class="str">critical,high</span>
    frameworks: <span class="str">gdpr,hipaa,euai,soc2</span>
    manifest: <span class="str">./agent-manifest.yaml</span>
    comment-on-pr: <span class="val">true</span></div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('github')">▶ Test</button>
                <button class="btn sm" onclick="saveConn('github')">Save</button>
                <button class="btn sm" onclick="copyGithubWorkflow()">Copy Workflow YAML</button>
              </div>
              <div class="conn-log" id="log-github"></div>
            </div>
          </div>

          <div class="conn-card" id="cc-gitlab">
            <div class="conn-head" onclick="toggleConn('cc-gitlab')">
              <div class="conn-icon" style="background:#fff0e6">🦊</div>
              <div><div class="conn-name">GitLab CI / Jenkins</div><div style="font-size:10px;color:var(--text-muted)">Webhook gate · REST API integration</div></div>
              <span class="conn-status cs-idle" id="cs-gitlab">Not configured</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">Policy Gate Endpoint (auto-generated)</div><input class="cred-inp" value="https://api.agentRadar.io/v1/gate/evaluate" readonly style="color:var(--text-muted)"></div>
                <div class="cred-field"><div class="cred-lbl">Policy API Key</div><input class="cred-inp" id="ci-gl-key" type="password" placeholder="key_live_xxxxxxxx"></div>
                <div class="cred-field"><div class="cred-lbl">Webhook Secret</div><input class="cred-inp" id="ci-gl-secret" type="password" placeholder="whsec_xxxxxxxx"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># .gitlab-ci.yml — add before deploy job</span>
agentRadar-gate:
  stage: validate
  script:
    - |
      RESULT=$(curl -s -X POST https://api.agentRadar.io/v1/gate/evaluate \
        -H <span class="str">"X-AgentRadar-Key: $AGENTRADARPOLICY_KEY"</span> \
        -d <span class="str">'{"agent_name":"'"$CI_PROJECT_NAME"'","env":"production"}'</span>)
      echo $RESULT | python3 -c <span class="str">"import sys,json; d=json.load(sys.stdin); sys.exit(0 if d['decision']=='approve' else 1)"</span></div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('gitlab')">▶ Test Webhook</button>
                <button class="btn sm" onclick="saveConn('gitlab')">Save</button>
              </div>
              <div class="conn-log" id="log-gitlab"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Healthcare ── -->
      <div class="env-pane" id="envp-health">
        <div class="conn-grid">
          <div class="conn-card" id="cc-epic">
            <div class="conn-head" onclick="toggleConn('cc-epic')">
              <div class="conn-icon" style="background:#e0f2fe">🏥</div>
              <div><div class="conn-name">Epic FHIR Gateway</div><div style="font-size:10px;color:var(--text-muted)">SMART on FHIR · Interconnect API · R4</div></div>
              <span class="conn-status cs-connected" id="cs-epic">Connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">FHIR Base URL</div><input class="cred-inp" id="ci-epic-url" value="https://fhir.epic.org/interconnect-fhir-oauth/api/FHIR/R4" placeholder="https://fhir.epic.org/..."></div>
                <div class="cred-field"><div class="cred-lbl">SMART Client ID</div><input class="cred-inp" id="ci-epic-cid" value="agentRadar-scanner-001" placeholder="client-id"></div>
                <div class="cred-field"><div class="cred-lbl">OAuth Scope</div><input class="cred-inp" value="system/AuditEvent.read system/CapabilityStatement.read" readonly style="color:var(--text-muted)"></div>
                <div class="cred-field"><div class="cred-lbl">BAA Status</div><select class="cred-select" id="ci-epic-baa"><option selected>Signed</option><option>Pending signature</option><option>Not started</option></select></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># What AgentRadar reads from Epic (no PHI)</span>
GET /metadata               <span class="cm"># CapabilityStatement</span>
GET /.well-known/smart-configuration  <span class="cm"># SMART apps</span>
GET /AuditEvent?agent=*    <span class="cm"># AI agent activity log</span>
<span class="hlt"># NEVER accessed: /Patient /Observation /Condition</span></div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('epic')">▶ Test FHIR</button>
                <button class="btn sm" onclick="runHealthScan('epic')">Scan FHIR Agents</button>
              </div>
              <div class="conn-log" id="log-epic"><div class="log-grn">[OK] Epic FHIR R4 endpoint reachable</div><div class="log-grn">[OK] CapabilityStatement retrieved</div><div class="log-amb">[WARN] 3 SMART apps found — 1 unregistered in AgentRadar</div></div>
            </div>
          </div>

          <div class="conn-card" id="cc-hl7">
            <div class="conn-head" onclick="toggleConn('cc-hl7')">
              <div class="conn-icon" style="background:#fce7f3">📡</div>
              <div><div class="conn-name">HL7 v2 MLLP Monitor</div><div style="font-size:10px;color:var(--text-muted)">Shadow HL7 listener detection · Port 2575</div></div>
              <span class="conn-status cs-connected" id="cs-hl7">Monitoring</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">HL7 Host Subnets to Monitor</div><input class="cred-inp" id="ci-hl7-nets" value="10.1.0.0/16, 10.2.0.0/16" placeholder="10.0.0.0/8"></div>
                <div class="cred-field"><div class="cred-lbl">MLLP Port</div><input class="cred-inp" id="ci-hl7-port" value="2575" placeholder="2575"></div>
                <div class="cred-field"><div class="cred-lbl">Alert on unauthorized listener</div><select class="cred-select" id="ci-hl7-alert"><option selected>Yes — CRITICAL alert</option><option>Yes — HIGH alert</option><option>Monitor only</option></select></div>
              </div>
              <div style="background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.2);border-radius:8px;padding:10px 14px;font-size:11px;color:#ef4444;margin:10px 0">⚠ Shadow HL7 Listener detected on 10.1.22.5:2575 — receiving live ADT feeds without HIPAA authorization. Immediate isolation recommended.</div>
              <div class="cred-actions">
                <button class="btn sm danger" onclick="quarantineHL7Shadow()">Quarantine Shadow Listener</button>
                <button class="btn sm" onclick="runHealthScan('hl7')">Rescan Ports</button>
              </div>
              <div class="conn-log" id="log-hl7"><div class="log-red">[ALERT] Port 2575 active on 10.1.22.5 — unauthorized HL7 listener</div><div class="log-grn">[OK] Approved HL7 listeners: cerner-hl7-gw (10.2.4.12:2575)</div></div>
            </div>
          </div>

          <div class="conn-card" id="cc-dicom">
            <div class="conn-head" onclick="toggleConn('cc-dicom')">
              <div class="conn-icon" style="background:#ecfdf5">🩻</div>
              <div><div class="conn-name">DICOM Gateway</div><div style="font-size:10px;color:var(--text-muted)">Medical imaging AI discovery · Port 104 / 11112</div></div>
              <span class="conn-status cs-idle" id="cs-dicom">Not configured</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">DICOM Gateway Host</div><input class="cred-inp" id="ci-dicom-host" placeholder="pacs.healthsys.org"></div>
                <div class="cred-field"><div class="cred-lbl">Port</div><input class="cred-inp" id="ci-dicom-port" value="104" placeholder="104 or 11112"></div>
                <div class="cred-field"><div class="cred-lbl">Called AE Title</div><input class="cred-inp" id="ci-dicom-aet" value="AGENTRADARPACSGW" placeholder="YOUR_AE_TITLE"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># AgentRadar DICOM C-ECHO test (only network ping)</span>
findscu -v -S -k 0008,0052=STUDY \
  <span class="str">"pacs.healthsys.org"</span> 104 \
  --aetitle AGENTRADARPACSGW \
  <span class="cm"># Returns AE Title list — identifies imaging AI services</span>
<span class="hlt"># No image data (pixel data) is ever read</span></div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('dicom')">▶ C-ECHO Test</button>
                <button class="btn sm" onclick="saveConn('dicom')">Save</button>
              </div>
              <div class="conn-log" id="log-dicom"></div>
            </div>
          </div>

          <div class="conn-card" id="cc-cerner">
            <div class="conn-head" onclick="toggleConn('cc-cerner')">
              <div class="conn-icon" style="background:#e0f2fe">🟦</div>
              <div><div class="conn-name">Oracle Cerner / Azure Health Data</div><div style="font-size:10px;color:var(--text-muted)">FHIR R4 · HL7 v2 · CCD</div></div>
              <span class="conn-status cs-idle" id="cs-cerner">Not configured</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">FHIR Endpoint</div><input class="cred-inp" id="ci-cerner-url" placeholder="https://fhir-myrecord.cerner.com/r4/tenant-id"></div>
                <div class="cred-field"><div class="cred-lbl">Client ID</div><input class="cred-inp" id="ci-cerner-cid" placeholder="SMART client ID"></div>
                <div class="cred-field"><div class="cred-lbl">Client Secret</div><input class="cred-inp" id="ci-cerner-sec" type="password" placeholder="••••••••"></div>
              </div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('cerner')">▶ Test</button>
                <button class="btn sm" onclick="saveConn('cerner')">Save</button>
              </div>
              <div class="conn-log" id="log-cerner"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Custom Scripts ── -->
      <div class="env-pane" id="envp-scripts">
        <div class="g2" style="margin-bottom:16px">
          <div class="card">
            <div class="card-head">
              <span class="card-title">Saved Scripts</span>
              <span class="card-meta" id="script-count">3 scripts</span>
              <button class="btn sm primary" style="margin-left:auto" onclick="newScript()">+ New Script</button>
            </div>
            <div style="padding:14px" id="script-list-wrap">
              <div class="script-list" id="script-list"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span class="card-title">Script Templates</span></div>
            <div style="padding:14px;display:flex;flex-direction:column;gap:8px" id="script-templates">
              <div class="script-item" style="cursor:pointer" onclick="loadTemplate('aws-enum')">
                <div class="script-dot" style="background:var(--amber)"></div>
                <div><div class="script-name">AWS AI Service Enumerator</div><div class="script-meta">Lists all Lambda, SageMaker, Bedrock resources</div></div>
                <span class="script-lang">Python</span>
                <button class="script-btn" onclick="event.stopPropagation();loadTemplate('aws-enum')">Load</button>
              </div>
              <div class="script-item" style="cursor:pointer" onclick="loadTemplate('fhir-scan')">
                <div class="script-dot" style="background:#38bdf8"></div>
                <div><div class="script-name">FHIR Endpoint Scanner</div><div class="script-meta">Discovers AI agents with FHIR access (no PHI)</div></div>
                <span class="script-lang">Python</span>
                <button class="script-btn" onclick="event.stopPropagation();loadTemplate('fhir-scan')">Load</button>
              </div>
              <div class="script-item" style="cursor:pointer" onclick="loadTemplate('hl7-detect')">
                <div class="script-dot" style="background:var(--red)"></div>
                <div><div class="script-name">HL7 Shadow Listener Detector</div><div class="script-meta">Scans port 2575 for unauthorized MLLP processes</div></div>
                <span class="script-lang">Bash</span>
                <button class="script-btn" onclick="event.stopPropagation();loadTemplate('hl7-detect')">Load</button>
              </div>
              <div class="script-item" style="cursor:pointer" onclick="loadTemplate('k8s-ai')">
                <div class="script-dot" style="background:var(--brand)"></div>
                <div><div class="script-name">K8s AI Pod Enumerator</div><div class="script-meta">kubectl-based AI workload discovery</div></div>
                <span class="script-lang">Bash</span>
                <button class="script-btn" onclick="event.stopPropagation();loadTemplate('k8s-ai')">Load</button>
              </div>
              <div class="script-item" style="cursor:pointer" onclick="loadTemplate('register-agents')">
                <div class="script-dot" style="background:var(--green)"></div>
                <div><div class="script-name">Bulk Agent Registration</div><div class="script-meta">Registers discovered agents via AgentRadar API</div></div>
                <span class="script-lang">JavaScript</span>
                <button class="script-btn" onclick="event.stopPropagation();loadTemplate('register-agents')">Load</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Code editor -->
        <div class="card">
          <div class="card-head">
            <span class="card-title" id="editor-title">Code Editor</span>
            <span class="card-meta" id="editor-lang-badge">JavaScript</span>
            <div style="margin-left:auto;display:flex;gap:8px">
              <select class="fsel" id="editor-lang" onchange="updateEditorLang()" style="font-size:11px;padding:4px 10px">
                <option value="javascript">JavaScript</option>
                <option value="python">Python</option>
                <option value="bash">Bash / Shell</option>
                <option value="yaml">YAML</option>
                <option value="json">JSON</option>
              </select>
              <button class="btn sm" onclick="saveScript()">💾 Save</button>
              <button class="btn sm ai" onclick="aiReviewScript()">✦ AI Review</button>
              <button class="btn sm primary" onclick="runScript()">▶ Run</button>
            </div>
          </div>
          <div class="code-editor-wrap">
            <div class="ce-body">
              <div class="ce-line-nums" id="ce-lines">1</div>
              <textarea class="ce-code" id="ce-editor" spellcheck="false" oninput="updateLineNums()" onkeydown="handleEditorKey(event)" placeholder="// Write your environment integration script here
// Access AgentRadar platform via window.AR object:
//   AR.agents      — agent inventory array
//   AR.addAgent()  — register a new agent
//   AR.log()       — write to output console below"></textarea>
            </div>
            <div class="ce-output" id="ce-output">// Output will appear here after running the script
</div>
          </div>
        </div>
      </div>

    </div>

    <!-- ══ CISO ══ -->
    <div class="view" id="view-ciso">
      <div id="ciso-alerts"></div>
      <div class="main-side-w">
        <div class="col">
          <div class="card">
            <div class="card-head"><span class="card-title">AI-Generated Executive Summary</span><span class="tier-badge t5">✦ AI Narration</span></div>
            <div class="ai-panel"><div class="ai-header"><div class="ai-orb"></div><span class="ai-label">AgentRadar Intelligence</span></div><div class="ai-text" id="ciso-ai">Loading analysis…</div></div>
          </div>
          <div class="card"><div class="card-head"><span class="card-title">Recommended Actions</span></div><div style="padding:14px;display:flex;flex-direction:column;gap:8px" id="ciso-recs"></div></div>
        </div>
        <div class="col">
          <div class="card">
            <div class="card-head"><span class="card-title">Posture Score</span></div>
            <div class="posture-wrap">
              <div class="posture-ring">
                <svg class="posture-svg" width="130" height="130" viewBox="0 0 130 130">
                  <circle cx="65" cy="65" r="54" fill="none" stroke="rgba(200,210,240,0.4)" stroke-width="10"/>
                  <circle id="posture-arc" cx="65" cy="65" r="54" fill="none" stroke="var(--amber)" stroke-width="10" stroke-linecap="round" stroke-dasharray="339" stroke-dashoffset="100"/>
                </svg>
                <div class="posture-num" id="posture-num" style="color:var(--amber-text)">--</div>
              </div>
              <div class="posture-sub">/ 100 — higher is riskier</div>
            </div>
          </div>
          <div class="card"><div class="card-head"><span class="card-title">Frameworks</span></div><div style="padding:14px;display:flex;flex-direction:column;gap:8px" id="ciso-fw"></div></div>
          <div class="card"><div class="card-head"><span class="card-title">Actions</span></div>
            <div style="padding:14px;display:flex;flex-direction:column;gap:8px">
              <button class="btn" onclick="alert('PDF download would trigger in production.')">↓ Download PDF</button>
              <button class="btn" onclick="alert('Pushed to #security-alerts (simulated).')">→ Push to Slack</button>
              <button class="btn ai" onclick="runAI()">✦ Regenerate Briefing</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ BENCHMARK ══ -->
    <div class="view" id="view-benchmark">
      <div class="stat-grid-4">
        <div class="stat-card purple"><div class="stat-glow"></div><div class="stat-lbl">Industry Percentile</div><div class="stat-val purple" id="bm-pct">—</div><div class="stat-sub">EU AI Act readiness</div></div>
        <div class="stat-card green"><div class="stat-glow"></div><div class="stat-lbl">Peers above</div><div class="stat-val green" id="bm-above">—</div></div>
        <div class="stat-card amber"><div class="stat-glow"></div><div class="stat-lbl">Sector average</div><div class="stat-val amber" id="bm-avg">—</div><div class="stat-sub">Financial services</div></div>
        <div class="stat-card blue"><div class="stat-glow"></div><div class="stat-lbl">Your score</div><div class="stat-val" style="color:var(--blue)" id="bm-yours">—</div></div>
      </div>
      <div class="card"><div class="card-head"><span class="card-title">Framework Benchmarks vs Sector</span><span class="tier-badge t5">Tier 5</span></div><div style="padding:20px 24px" id="bm-list"></div></div>
    </div>

    <!-- ══ NOTIFICATIONS ══ -->
    <div class="view" id="view-notifications">
      <div class="card"><div class="card-head"><span class="card-title">Notifications</span><button class="btn sm" onclick="markAllRead()" style="margin-left:auto">Mark all read</button></div><div id="notif-list"></div></div>
    </div>

    <!-- ══ ACTIVITY ══ -->
    <div class="view" id="view-activity">
      <div class="card"><div class="card-head"><span class="card-title">Activity Log</span><span class="card-meta" id="act-count">0 events</span><button class="btn sm" onclick="clearLog()" style="margin-left:auto">Clear</button></div><div class="tl" id="act-tl"></div></div>
    </div>

  </div><!-- #content -->
</main>
</div><!-- #app -->

<!-- ═══ DRAWER ═══ -->
<div id="drawer-backdrop" onclick="closeDrawer()"></div>
<div id="drawer" style="position:fixed"><div id="drw-inner"></div></div>

<!-- ═══ SCAN MODAL ═══ -->
<div class="modal" id="modal-scan">
  <div class="scan-modal-box">
    <div class="scan-title">⟳ Environment Scan</div>
    <div class="scan-sub">Discovering AI agents across all registered environments and cross-referencing fingerprint library</div>
    <div class="prog-bg"><div class="prog-fill" id="scan-fill"></div></div>
    <div class="scan-step-txt" id="scan-step">Initializing…</div>
    <div class="scan-log" id="scan-log"></div>
  </div>
</div>

<!-- ═══ ADD AGENT MODAL ═══ -->
<div class="modal" id="modal-add">
  <div class="modal-box" style="width:520px">
    <div class="modal-head"><div class="modal-title">Register New Agent</div><button class="btn sm" onclick="closeModal('modal-add')">✕</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="ff"><label class="flbl">Agent Name</label><input class="finp" id="f-name" placeholder="e.g. GPT-4 Ops Agent"></div>
        <div class="ff"><label class="flbl">Type</label><select class="fsel" id="f-type"><option value="agent">AI Agent</option><option value="bot">Bot</option></select></div>
        <div class="ff"><label class="flbl">Environment</label><select class="fsel" id="f-env"><option value="Cloud">Cloud</option><option value="On-Prem">On-Prem</option><option value="Hybrid">Hybrid</option></select></div>
        <div class="ff"><label class="flbl">Risk Level</label><select class="fsel" id="f-risk"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="critical">Critical</option></select></div>
        <div class="ff full"><label class="flbl">Protocols (comma-separated)</label><input class="finp" id="f-proto" placeholder="REST, gRPC, WebSocket…"></div>
        <div class="ff full"><label class="flbl">Data Access Scope</label><input class="finp" id="f-data" placeholder="e.g. Customer PII, Internal docs…"></div>
        <div class="ff full"><label class="flbl">Notes / Risk Detail</label><textarea class="ftxt" id="f-notes" placeholder="Describe purpose or risk…"></textarea></div>
      </div>
      <div class="factions"><button class="btn" onclick="closeModal('modal-add')">Cancel</button><button class="btn primary" onclick="submitAgent()">Register Agent</button></div>
    </div>
  </div>
</div>

<!-- ═══ ADD POLICY MODAL ═══ -->
<div class="modal" id="modal-policy">
  <div class="modal-box" style="width:480px">
    <div class="modal-head"><div class="modal-title">New Policy Rule</div><button class="btn sm" onclick="closeModal('modal-policy')">✕</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <div class="ff full"><label class="flbl">Policy Name</label><input class="finp" id="p-name" placeholder="e.g. No PII without GDPR pass"></div>
        <div class="ff"><label class="flbl">Condition</label><select class="fsel" id="p-cond"><option value="pii_no_gdpr">PII access without GDPR</option><option value="shadow_critical">Shadow + Critical risk</option><option value="unknown_proto">Unknown protocol</option><option value="cloud_no_soc2">Cloud without SOC2</option></select></div>
        <div class="ff"><label class="flbl">Action</label><select class="fsel" id="p-act"><option value="flag">Flag for review</option><option value="alert">Alert CISO</option><option value="quarantine">Auto-quarantine</option></select></div>
        <div class="ff full"><label class="flbl">Description</label><input class="finp" id="p-desc" placeholder="Why this policy exists…"></div>
      </div>
      <div class="factions"><button class="btn" onclick="closeModal('modal-policy')">Cancel</button><button class="btn primary" onclick="submitPolicy()">Save Policy</button></div>
    </div>
  </div>
</div>

<!-- ═══ AI AGENT KEY MODAL ═══ -->
<!-- Lineage tooltip -->
<div id="ln-tooltip">
  <div class="ln-tt-name">—</div>
  <div class="ln-tt-row"><span class="ln-tt-key">Data type</span><span class="ln-tt-val">—</span></div>
  <div class="ln-tt-row"><span class="ln-tt-key">Encrypted</span><span class="ln-enc-y">—</span></div>
  <div class="ln-tt-row"><span class="ln-tt-key">BAA</span><span class="ln-tt-val">—</span></div>
  <div class="ln-tt-row"><span class="ln-tt-key">Risk</span><span class="ln-tt-val">—</span></div>
  <div class="ln-tt-row"><span class="ln-tt-key">Owner</span><span class="ln-tt-val">—</span></div>
</div>


<!-- ══ LOGIN SCREEN ══ -->
<div id="view-admin" class="view">
  <div style="max-width:1100px;margin:0 auto;padding:24px">
    <div style="font-size:20px;font-weight:700;margin-bottom:4px">Platform Administration</div>
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:24px">Manage tenant modules, integrations and users</div>

    <!-- Tenant selector -->
    <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:14px;padding:20px;margin-bottom:20px">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px"><div style="font-size:14px;font-weight:600">Tenant Management</div><span id="admin-save-indicator" style="font-size:12px;font-weight:600"></span></div>
      <div style="display:flex;gap:10px;align-items:center;margin-bottom:16px">
        <select id="admin-tenant-select" onchange="loadTenantConfig(this.value)" style="flex:1;padding:8px 10px;border-radius:8px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);font-size:13px">
          <option value="00000000-0000-0000-0000-000000000001">agent_radar (default)</option>
        </select>
        <button onclick="loadTenants()" style="padding:8px 14px;border-radius:8px;border:1px solid var(--glass-border-dim);background:var(--bg-secondary);color:var(--text-primary);font-size:12px;cursor:pointer">↻ Refresh</button>
      </div>

      <!-- Module toggles -->
      <!-- Quick Presets -->
      <div style="font-size:13px;font-weight:600;margin-bottom:10px">Quick Presets</div>
      <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap">
        <button onclick="applyPreset('full')" style="padding:6px 14px;border-radius:8px;border:none;background:var(--accent-primary);color:#fff;font-size:11px;font-weight:600;cursor:pointer">⚡ Full Platform</button>
        <button onclick="applyPreset('discovery_governance_integration')" style="padding:6px 14px;border-radius:8px;border:1px solid var(--glass-border-dim);background:var(--bg-secondary);color:var(--text-primary);font-size:11px;font-weight:600;cursor:pointer">🔍 Discovery + Governance + Integrations</button>
        <button onclick="applyPreset('compliance_only')" style="padding:6px 14px;border-radius:8px;border:1px solid var(--glass-border-dim);background:var(--bg-secondary);color:var(--text-primary);font-size:11px;font-weight:600;cursor:pointer">📋 Compliance Only</button>
      </div>

      <div style="font-size:13px;font-weight:600;margin-bottom:10px">Enabled Modules</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px" id="admin-module-toggles">
        <div class="admin-toggle" onclick="toggleMod('tier1')" id="mod-tier1-btn"><span class="admin-toggle-label">📡 Tier 1 — Discovery</span><div class="admin-toggle-sw on" id="mod-tier1-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('tier2')" id="mod-tier2-btn"><span class="admin-toggle-label">🛡️ Tier 2 — Governance</span><div class="admin-toggle-sw on" id="mod-tier2-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('tier3')" id="mod-tier3-btn"><span class="admin-toggle-label">🧠 Tier 3 — Intelligence</span><div class="admin-toggle-sw on" id="mod-tier3-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('tier4')" id="mod-tier4-btn"><span class="admin-toggle-label">🔗 Tier 4 — Integrations</span><div class="admin-toggle-sw on" id="mod-tier4-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('dashboard')" id="mod-dashboard-btn"><span class="admin-toggle-label">📊 Dashboard</span><div class="admin-toggle-sw on" id="mod-dashboard-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('compliance')" id="mod-compliance-btn"><span class="admin-toggle-label">✅ Compliance</span><div class="admin-toggle-sw on" id="mod-compliance-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('remediation')" id="mod-remediation-btn"><span class="admin-toggle-label">🔧 Remediation</span><div class="admin-toggle-sw on" id="mod-remediation-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('dataLineage')" id="mod-dataLineage-btn"><span class="admin-toggle-label">🗺️ Data Lineage</span><div class="admin-toggle-sw on" id="mod-dataLineage-dot"></div></div>
        <div class="admin-toggle" onclick="toggleMod('activityFeed')" id="mod-activityFeed-btn"><span class="admin-toggle-label">📋 Activity Feed</span><div class="admin-toggle-sw on" id="mod-activityFeed-dot"></div></div>
      </div>

      <!-- Integration toggles -->
      <div style="font-size:13px;font-weight:600;margin-bottom:10px">Enabled Integrations</div>
      <!-- Integration toggles grouped by category -->
      <div style="margin-bottom:10px">
        <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px">☁️ Cloud</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px" id="admin-integration-toggles">
        <div class="admin-toggle" onclick="toggleInt('azure')" id="int-azure-btn"><span class="admin-toggle-label">Azure</span><div class="admin-toggle-sw on" id="int-azure-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('aws')" id="int-aws-btn"><span class="admin-toggle-label">AWS</span><div class="admin-toggle-sw on" id="int-aws-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('gcp')" id="int-gcp-btn"><span class="admin-toggle-label">Google Cloud</span><div class="admin-toggle-sw on" id="int-gcp-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('copilotStudio')" id="int-copilotStudio-btn"><span class="admin-toggle-label">Copilot Studio</span><div class="admin-toggle-sw on" id="int-copilotStudio-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('salesforce')" id="int-salesforce-btn"><span class="admin-toggle-label">Salesforce</span><div class="admin-toggle-sw on" id="int-salesforce-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('workday')" id="int-workday-btn"><span class="admin-toggle-label">Workday</span><div class="admin-toggle-sw on" id="int-workday-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('oracleCloud')" id="int-oracleCloud-btn"><span class="admin-toggle-label">Oracle Cloud</span><div class="admin-toggle-sw on" id="int-oracleCloud-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('okta')" id="int-okta-btn"><span class="admin-toggle-label">Okta IAM</span><div class="admin-toggle-sw on" id="int-okta-dot"></div></div>
        </div>
      </div>
      <div style="margin-bottom:10px">
        <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px">💻 Endpoint</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">
        <div class="admin-toggle" onclick="toggleInt('cortexXDR')" id="int-cortexXDR-btn"><span class="admin-toggle-label">Cortex XDR</span><div class="admin-toggle-sw on" id="int-cortexXDR-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('crowdstrike')" id="int-crowdstrike-btn"><span class="admin-toggle-label">CrowdStrike</span><div class="admin-toggle-sw on" id="int-crowdstrike-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('intune')" id="int-intune-btn"><span class="admin-toggle-label">MS Intune</span><div class="admin-toggle-sw on" id="int-intune-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('netskope')" id="int-netskope-btn"><span class="admin-toggle-label">Netskope</span><div class="admin-toggle-sw on" id="int-netskope-dot"></div></div>
        </div>
      </div>
      <div>
        <div style="font-size:10px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px">📡 SIEM</div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px">
        <div class="admin-toggle" onclick="toggleInt('splunk')" id="int-splunk-btn"><span class="admin-toggle-label">Splunk</span><div class="admin-toggle-sw on" id="int-splunk-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('sentinel')" id="int-sentinel-btn"><span class="admin-toggle-label">MS Sentinel</span><div class="admin-toggle-sw on" id="int-sentinel-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('qradar')" id="int-qradar-btn"><span class="admin-toggle-label">IBM QRadar</span><div class="admin-toggle-sw on" id="int-qradar-dot"></div></div>
        <div class="admin-toggle" onclick="toggleInt('elastic')" id="int-elastic-btn"><span class="admin-toggle-label">Elastic SIEM</span><div class="admin-toggle-sw on" id="int-elastic-dot"></div></div>
        </div>
      </div>
    </div>

    <!-- Users table -->
    <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:14px;padding:20px">
      <div style="font-size:14px;font-weight:600;margin-bottom:12px">Tenant Users</div>
      <div id="admin-users-table" style="font-size:12px;color:var(--text-muted)">Select a tenant to view users</div>
    </div>
  </div>
</div>

<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">
      <div class="login-logo-icon"><svg width="18" height="18" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="2.2" fill="white"/><circle cx="7" cy="7" r="5" stroke="white" stroke-width="1" stroke-dasharray="2 1.5"/><circle cx="2" cy="7" r="1" fill="white" opacity=".6"/><circle cx="12" cy="7" r="1" fill="white" opacity=".6"/></svg></div>
      <span class="login-title">AgentRadar</span>
    </div>
    <div style="font-size:13px;color:var(--text-muted);margin-bottom:20px;line-height:1.6">AI Governance Platform — sign in to continue</div>
    <div class="login-field"><div class="login-lbl">Email</div><input class="login-inp" id="login-email" type="email" placeholder="you@company.com" value="admin@agentradar.local"></div>
    <div class="login-field"><div class="login-lbl">Password</div><input class="login-inp" id="login-password" type="password" placeholder="Password" value="ChangeMe123!" onkeydown="if(event.key==='Enter')doLogin()"></div>
    <div id="login-api-err" style="font-size:11px;color:#dc2626;margin-bottom:8px;display:none">Connecting in demo mode — API unavailable</div>
    <div class="login-field"><div class="login-lbl">Select your role</div>
      <div class="role-grid">
        <div class="role-card selected" id="role-ciso" onclick="selectRole('ciso')"><div class="role-name">CISO</div><div class="role-desc">Full access — all views, actions, exports</div><span class="role-badge rb-ciso">Full admin</span></div>
        <div class="role-card" id="role-analyst" onclick="selectRole('analyst')"><div class="role-name">Security Analyst</div><div class="role-desc">All views, no approve/quarantine</div><span class="role-badge rb-analyst">Analyst</span></div>
        <div class="role-card" id="role-auditor" onclick="selectRole('auditor')"><div class="role-name">Auditor</div><div class="role-desc">Read-only + export only</div><span class="role-badge rb-auditor">Auditor</span></div>
        <div class="role-card" id="role-viewer" onclick="selectRole('viewer')"><div class="role-name">Viewer</div><div class="role-desc">Dashboard view only</div><span class="role-badge rb-viewer">Read-only</span></div>
      </div>
    </div>
    <button class="btn primary" style="width:100%;padding:10px" onclick="doLogin()">Sign in to AgentRadar</button>
    <div style="display:flex;align-items:center;gap:10px;margin:14px 0">
      <div style="flex:1;height:1px;background:var(--glass-border-dim)"></div>
      <span style="font-size:12px;color:var(--text-muted)">or</span>
      <div style="flex:1;height:1px;background:var(--glass-border-dim)"></div>
    </div>
    <button onclick="window.location.href='/api/auth/sso/azure'" style="width:100%;padding:10px;border-radius:10px;border:1px solid var(--glass-border-dim);background:var(--glass-white);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;font-size:14px;font-weight:600;color:var(--text-primary)">
      <svg width="18" height="18" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1h10v10H1z" fill="#f25022"/><path d="M12 1h10v10H12z" fill="#7fba00"/><path d="M1 12h10v10H1z" fill="#00a4ef"/><path d="M12 12h10v10H12z" fill="#ffb900"/></svg>
      Continue with Microsoft Entra
    </button>
    <button id="btn-okta-sso" onclick="window.location.href='/api/auth/sso/okta'" style="width:100%;padding:10px;border-radius:10px;border:1px solid var(--glass-border-dim);background:var(--glass-white);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;font-size:14px;font-weight:600;color:var(--text-primary);margin-top:8px;display:none">
      <svg width="18" height="18" viewBox="0 0 64 64"><circle cx="32" cy="32" r="32" fill="#007DC1"/><circle cx="32" cy="32" r="14" fill="white"/></svg>
      Continue with Okta
    </button>
    <div style="margin-top:10px;text-align:center;font-size:11px;color:var(--text-muted)">SSO / SAML available for enterprise accounts</div>
  </div>
</div>

<!-- ══ ONBOARDING WIZARD ══ -->
<div id="onboarding-overlay" class="hidden">
  <div class="onb-box">
    <div class="onb-progress"><div class="onb-progress-fill" id="onb-fill" style="width:25%"></div></div>
    <div class="onb-header">
      <div class="onb-step-label" id="onb-step-lbl">Step 1 of 4</div>
      <div class="onb-title" id="onb-title">Welcome to AgentRadar</div>
      <div class="onb-sub" id="onb-sub">Let's get your organization set up in under 5 minutes.</div>
    </div>
    <div class="onb-body" id="onb-body">
      <div class="onb-field"><div class="onb-lbl">Organization name</div><input class="onb-inp" id="onb-org" placeholder="e.g. HealthSystem Inc."></div>
      <div class="onb-field"><div class="onb-lbl">Primary environment</div><select class="onb-inp" id="onb-env"><option>Healthcare / Clinical</option><option>Financial Services</option><option>Technology</option><option>Government</option><option>Other</option></select></div>
    </div>
    <div class="onb-footer">
      <div class="onb-steps">
        <div class="onb-step-dot active" id="onbd-1"></div>
        <div class="onb-step-dot" id="onbd-2"></div>
        <div class="onb-step-dot" id="onbd-3"></div>
        <div class="onb-step-dot" id="onbd-4"></div>
      </div>
      <button class="btn sm" onclick="skipOnboarding()">Skip</button>
      <button class="btn primary sm" id="onb-next-btn" onclick="onbNext()">Next →</button>
    </div>
  </div>
</div>

<!-- ══ HELP PANEL ══ -->
<div id="help-panel">
  <div class="help-header">
    <span class="help-title" id="help-title">Help</span>
    <button class="btn sm" onclick="closeHelp()">✕</button>
  </div>
  <div class="help-body" id="help-body">
    <div style="font-size:12px;color:var(--text-muted)">Select a view to see contextual help.</div>
  </div>
</div>
<div id="help-backdrop" style="display:none;position:fixed;inset:0;z-index:249" onclick="closeHelp()"></div>

<!-- ══ BULK IMPORT MODAL ══ -->
<div class="modal" id="modal-import">
  <div class="modal-box" style="width:560px;max-width:96vw">
    <div class="modal-head"><div class="modal-title">Bulk Agent Import</div><button class="btn sm" onclick="closeModal('modal-import')">✕</button></div>
    <div style="padding:16px 20px">
      <div class="import-drop" onclick="document.getElementById('import-file').click()" id="import-drop">
        <div style="font-size:24px;margin-bottom:8px">📥</div>
        <div style="font-size:13px;font-weight:600;color:var(--text-primary);margin-bottom:4px">Drop CSV or JSON file here</div>
        <div style="font-size:11px;color:var(--text-muted)">CSV: name, type, env, protocols, risk, owner, phi, domain</div>
        <input type="file" id="import-file" accept=".csv,.json" style="display:none" onchange="handleImportFile(this)">
      </div>
      <div id="import-preview" class="import-preview" style="display:none"></div>
      <div id="import-summary" style="font-size:12px;color:var(--text-muted);margin-top:8px"></div>
    </div>
    <div class="factions">
      <button class="btn" onclick="closeModal('modal-import')">Cancel</button>
      <button class="btn primary" id="import-confirm-btn" onclick="confirmImport()" style="display:none">Import All Agents</button>
    </div>
  </div>
</div>

<!-- ══ RISK ACCEPTANCE MODAL ══ -->
<div class="modal" id="modal-risk-accept">
  <div class="modal-box">
    <div class="modal-head"><div class="modal-title">Risk Acceptance</div><button class="btn sm" onclick="closeModal('modal-risk-accept')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px" id="ra-agent-info">Agent: —</div>
      <div class="onb-field"><div class="onb-lbl">Decision</div>
        <select class="login-inp" id="ra-decision"><option value="accept">Accept risk</option><option value="mitigate">Mitigate (controls applied)</option><option value="transfer">Transfer (insured/third-party)</option></select>
      </div>
      <div class="onb-field"><div class="onb-lbl">Reason</div><textarea class="login-inp" id="ra-reason" rows="2" placeholder="Business justification for accepting this risk…" style="resize:none"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="onb-field"><div class="onb-lbl">Approver</div><input class="login-inp" id="ra-approver" placeholder="CISO / Risk owner"></div>
        <div class="onb-field"><div class="onb-lbl">Expires</div>
          <select class="login-inp" id="ra-expiry"><option value="90">90 days</option><option value="180">180 days</option><option value="365">1 year</option><option value="custom">Custom date</option></select>
        </div>
      </div>
    </div>
    <div class="factions"><button class="btn" onclick="closeModal('modal-risk-accept')">Cancel</button><button class="btn primary" onclick="submitRiskAcceptance()">Save Acceptance</button></div>
  </div>
</div>

<!-- ══ SLA MODAL ══ -->
<div class="modal" id="modal-sla">
  <div class="modal-box">
    <div class="modal-head"><div class="modal-title">Assign Remediation</div><button class="btn sm" onclick="closeModal('modal-sla')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px" id="sla-agent-info">—</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div class="onb-field"><div class="onb-lbl">Assignee</div><input class="login-inp" id="sla-assignee" placeholder="security@company.com"></div>
        <div class="onb-field"><div class="onb-lbl">Priority</div>
          <select class="login-inp" id="sla-priority"><option value="P1">P1 — Critical (24h)</option><option value="P2">P2 — High (7 days)</option><option value="P3">P3 — Medium (30 days)</option></select>
        </div>
      </div>
      <div class="onb-field"><div class="onb-lbl">Due date</div><input class="login-inp" id="sla-due" type="date"></div>
      <div class="onb-field"><div class="onb-lbl">Notes</div><textarea class="login-inp" id="sla-notes" rows="2" placeholder="Remediation plan…" style="resize:none"></textarea></div>
    </div>
    <div class="factions"><button class="btn" onclick="closeModal('modal-sla')">Cancel</button><button class="btn primary" onclick="submitSLA()">Assign</button></div>
  </div>
</div>

<!-- ══ WEBHOOKS MODAL ══ -->
<div class="modal" id="modal-webhooks">
  <div class="modal-box" style="width:520px;max-width:96vw">
    <div class="modal-head"><div class="modal-title">Webhook Configuration</div><button class="btn sm" onclick="closeModal('modal-webhooks')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="margin-bottom:14px"><div class="onb-lbl" style="margin-bottom:5px">Webhook URL</div><div style="display:flex;gap:8px"><input class="login-inp" id="wh-url-inp" placeholder="https://hooks.slack.com/services/..." style="flex:1"><button class="btn sm primary" onclick="addWebhook()">Add</button></div></div>
      <div class="onb-lbl" style="margin-bottom:8px">Trigger events</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:14px">
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary);cursor:pointer"><input type="checkbox" id="wh-shadow" checked> Shadow agent detected</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary);cursor:pointer"><input type="checkbox" id="wh-hipaa" checked> HIPAA violation</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary);cursor:pointer"><input type="checkbox" id="wh-critical" checked> Critical risk found</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-secondary);cursor:pointer"><input type="checkbox" id="wh-scan"> Scan completed</label>
      </div>
      <div class="onb-lbl" style="margin-bottom:6px">Configured webhooks</div>
      <div id="wh-list" style="min-height:40px"></div>
    </div>
    <div class="factions"><button class="btn" onclick="closeModal('modal-webhooks')">Close</button><button class="btn primary" onclick="testWebhook()">Test Webhook</button></div>
  </div>
</div>



<!-- ── SESSION TIMEOUT WARNING ── -->
<div id="session-warn" class="hidden">
  <span class="sw-icon">⏱</span>
  <div>
    <div class="sw-msg">Session expiring soon</div>
    <div class="sw-sub">You will be logged out in <span id="sw-countdown">60</span>s due to inactivity</div>
  </div>
  <button class="btn sm primary" onclick="resetSessionTimer()">Stay logged in</button>
</div>

<!-- ── MFA SETUP / VERIFY MODAL ── -->
<div class="modal" id="modal-mfa">
  <div class="modal-box" style="width:400px;max-width:96vw">
    <div class="modal-head"><div class="modal-title" id="mfa-title">Two-factor authentication</div><button class="btn sm" onclick="closeModal('modal-mfa')">✕</button></div>
    <div class="mfa-box" id="mfa-body">
      <div id="mfa-setup-phase">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:12px">Scan this QR code with your authenticator app (Google Authenticator, Authy, 1Password)</div>
        <div id="mfa-qr" style="width:160px;height:160px;margin:12px auto;background:#fff;border:1px solid #e2e8f0;border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden"></div>
        <div style="font-family:monospace;font-size:11px;text-align:center;margin:6px 0;color:var(--text-secondary);word-break:break-all;padding:0 8px" id="mfa-secret">Loading…</div>
        <div style="font-size:11px;color:var(--text-muted);margin-bottom:12px">Or enter this secret key manually in your authenticator app</div>
        <button class="btn sm primary" onclick="showMFAVerify()">I've scanned the code →</button>
      </div>
      <div id="mfa-verify-phase" style="display:none">
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:16px">Enter the 6-digit code from your authenticator app</div>
        <div class="mfa-code-row" id="mfa-digits"></div>
        <div id="mfa-error" style="font-size:11px;color:var(--red-text);margin-top:8px;display:none">Incorrect code — try again</div>
        <button class="btn primary" style="width:100%;margin-top:14px;padding:9px" onclick="verifyMFACode()">Verify and enable MFA</button>
      </div>
    </div>
  </div>
</div>

<!-- ── EVIDENCE PACKAGE MODAL ── -->
<div class="modal" id="modal-evidence">
  <div class="modal-box" style="width:520px;max-width:96vw">
    <div class="modal-head"><div class="modal-title">Export Evidence Package</div><button class="btn sm" onclick="closeModal('modal-evidence')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px">Select the evidence to include in your compliance export. The package downloads as a ZIP file suitable for auditor review.</div>
      <div id="evidence-items">
        <div class="evidence-item"><span class="evidence-icon">📋</span><div><div class="evidence-name">Agent Inventory</div><div class="evidence-desc">All registered agents — name, type, env, risk, owner, first detected</div></div><input type="checkbox" checked id="ev-agents"></div>
        <div class="evidence-item"><span class="evidence-icon">✅</span><div><div class="evidence-name">Compliance Matrix</div><div class="evidence-desc">Pass/warn/fail per agent per framework (SOC 2, HIPAA, GDPR, NIST, EU AI Act…)</div></div><input type="checkbox" checked id="ev-compliance"></div>
        <div class="evidence-item"><span class="evidence-icon">⚖</span><div><div class="evidence-name">Risk Acceptance Records</div><div class="evidence-desc">All accepted risks with owner, reason, date, expiry</div></div><input type="checkbox" checked id="ev-risks"></div>
        <div class="evidence-item"><span class="evidence-icon">✔</span><div><div class="evidence-name">Approval Workflow Log</div><div class="evidence-desc">All agent approvals with approver, date, expiry countdown</div></div><input type="checkbox" checked id="ev-approvals"></div>
        <div class="evidence-item"><span class="evidence-icon">🔍</span><div><div class="evidence-name">Scan History</div><div class="evidence-desc">Last 10 scans per scanner — timestamp, agents found, duration</div></div><input type="checkbox" checked id="ev-scans"></div>
        <div class="evidence-item"><span class="evidence-icon">📜</span><div><div class="evidence-name">GDPR Article 30 Report</div><div class="evidence-desc">Records of processing per AI agent — controller, purpose, data categories, recipients</div></div><input type="checkbox" checked id="ev-gdpr"></div>
        <div class="evidence-item"><span class="evidence-icon">📝</span><div><div class="evidence-name">Policy Violations Log</div><div class="evidence-desc">All policy violations with status, remediation, SLA compliance</div></div><input type="checkbox" id="ev-violations"></div>
      </div>
      <div style="margin-top:12px">
        <label style="font-size:11px;color:var(--text-muted);display:flex;align-items:center;gap:8px;cursor:pointer">
          <input type="checkbox" id="ev-encrypt"> Password-protect the export (AES-256)
        </label>
        <input class="login-inp" id="ev-password" type="password" placeholder="Export password" style="margin-top:8px;display:none">
      </div>
    </div>
    <div class="factions">
      <button class="btn" onclick="closeModal('modal-evidence')">Cancel</button>
      <button class="btn primary" onclick="exportEvidencePackage()">↓ Download Evidence Package</button>
    </div>
  </div>
</div>

<!-- ── SHORTCUTS PANEL ── -->
<div id="shortcuts-panel" class="hidden" onclick="this.classList.add('hidden')">
  <div class="shortcuts-box" onclick="event.stopPropagation()">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <div style="font-size:14px;font-weight:700;color:var(--text-primary)">Keyboard shortcuts</div>
      <button class="btn sm" onclick="document.getElementById('shortcuts-panel').classList.add('hidden')">✕</button>
    </div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>D</kbd></div><div class="shortcut-desc">Go to Agent Discovery</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>S</kbd></div><div class="shortcut-desc">Go to Shadow AI</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>C</kbd></div><div class="shortcut-desc">Go to Compliance</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>L</kbd></div><div class="shortcut-desc">Go to Data Lineage</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>R</kbd></div><div class="shortcut-desc">Go to CISO Report</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>G</kbd><kbd>I</kbd></div><div class="shortcut-desc">Go to Connect Hub</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>/</kbd></div><div class="shortcut-desc">Focus agent search</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>⌘</kbd><kbd>K</kbd></div><div class="shortcut-desc">Open AI Agent panel</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>Q</kbd></div><div class="shortcut-desc">Quarantine all selected</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>N</kbd></div><div class="shortcut-desc">Register new agent</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>⌘</kbd><kbd>E</kbd></div><div class="shortcut-desc">Export evidence package</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>Esc</kbd></div><div class="shortcut-desc">Close modal / panel</div></div>
    <div class="shortcut-row"><div class="shortcut-keys"><kbd>?</kbd></div><div class="shortcut-desc">Show this panel</div></div>
  </div>
</div>

<!-- ── INCIDENT RESPONSE MODAL ── -->
<div class="modal" id="modal-ir">
  <div class="modal-box" style="width:540px;max-width:96vw">
    <div class="modal-head"><div class="modal-title">Automated Incident Response</div><button class="btn sm" onclick="closeModal('modal-ir')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px">Configure automatic response chains for critical findings. Actions execute in sequence within 60 seconds of detection.</div>
      <div id="ir-rules-list" style="margin-bottom:12px"></div>
      <div style="border:1px solid rgba(200,210,240,.3);border-radius:var(--r10);padding:14px">
        <div style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:10px">Add new rule</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px">
          <div><div class="onb-lbl">Trigger condition</div>
            <select class="login-inp" id="ir-trigger">
              <option value="critical_shadow_phi">Critical + Shadow AI + PHI</option>
              <option value="critical_shadow">Critical + Shadow AI</option>
              <option value="critical">Any Critical risk</option>
              <option value="phi_no_hipaa">PHI agent failing HIPAA</option>
              <option value="new_claude_agent">New Claude Code agent detected</option>
            </select>
          </div>
          <div><div class="onb-lbl">Auto-quarantine</div>
            <select class="login-inp" id="ir-quarantine">
              <option value="yes">Yes — quarantine immediately</option>
              <option value="no">No — alert only</option>
            </select>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
          <div><div class="onb-lbl">Notify (webhook)</div>
            <select class="login-inp" id="ir-notify">
              <option value="all">All configured webhooks</option>
              <option value="critical_only">Critical webhooks only</option>
              <option value="none">None</option>
            </select>
          </div>
          <div><div class="onb-lbl">Create SLA ticket</div>
            <select class="login-inp" id="ir-sla">
              <option value="P1">P1 — 24h</option>
              <option value="P2">P2 — 7 days</option>
              <option value="none">No ticket</option>
            </select>
          </div>
        </div>
        <button class="btn primary sm" onclick="addIRRule()" style="margin-top:12px">Add rule</button>
      </div>
    </div>
    <div class="factions"><button class="btn" onclick="closeModal('modal-ir')">Close</button></div>
  </div>
</div>

<!-- ── SCHEDULED REPORTS MODAL ── -->
<div class="modal" id="modal-schedule">
  <div class="modal-box" style="width:460px;max-width:96vw">
    <div class="modal-head"><div class="modal-title">Schedule CISO Report Delivery</div><button class="btn sm" onclick="closeModal('modal-schedule')">✕</button></div>
    <div style="padding:16px 20px">
      <div class="onb-field"><div class="onb-lbl">Frequency</div>
        <select class="login-inp" id="sched-freq">
          <option value="weekly">Weekly</option>
          <option value="monthly">Monthly (1st of month)</option>
          <option value="quarterly">Quarterly</option>
        </select>
      </div>
      <div class="onb-field"><div class="onb-lbl">Recipients (comma-separated)</div>
        <input class="login-inp" id="sched-emails" placeholder="ciso@company.com, board@company.com">
      </div>
      <div class="onb-field"><div class="onb-lbl">Format</div>
        <select class="login-inp" id="sched-format">
          <option value="text">Text summary (default)</option>
          <option value="pdf">PDF (requires backend)</option>
        </select>
      </div>
      <div id="sched-list" style="margin-top:14px"></div>
    </div>
    <div class="factions">
      <button class="btn" onclick="closeModal('modal-schedule')">Close</button>
      <button class="btn primary" onclick="saveSchedule()">Save schedule</button>
    </div>
  </div>
</div>

<!-- ── RETIRE AGENT MODAL ── -->
<div class="modal" id="modal-retire">
  <div class="modal-box">
    <div class="modal-head"><div class="modal-title">Retire Agent</div><button class="btn sm" onclick="closeModal('modal-retire')">✕</button></div>
    <div style="padding:16px 20px">
      <div style="font-size:12px;color:var(--text-muted);margin-bottom:14px" id="retire-agent-info">Agent: —</div>
      <div class="onb-field"><div class="onb-lbl">Reason for retirement</div>
        <select class="login-inp" id="retire-reason">
          <option value="replaced">Replaced by newer agent</option>
          <option value="decommissioned">Decommissioned — no replacement</option>
          <option value="compliance">Retired for compliance reasons</option>
          <option value="cost">Retired for cost reasons</option>
        </select>
      </div>
      <div class="onb-field"><div class="onb-lbl">Successor agent (if applicable)</div>
        <input class="login-inp" id="retire-successor" placeholder="Name of replacement agent or 'none'">
      </div>
      <div class="onb-field">
        <label style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-muted);cursor:pointer">
          <input type="checkbox" id="retire-data-confirm">
          I confirm that data deletion or migration has been addressed
        </label>
      </div>
    </div>
    <div class="factions">
      <button class="btn" onclick="closeModal('modal-retire')">Cancel</button>
      <button class="btn primary" style="background:var(--red);border-color:var(--red)" onclick="confirmRetire()">Retire Agent</button>
    </div>
  </div>
</div>

