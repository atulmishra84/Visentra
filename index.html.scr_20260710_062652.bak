          <textarea id="cd-gcp-key" placeholder='Service Account Key JSON {"type":"service_account",...}' style="font-size:11px;padding:7px 10px;border-radius:7px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box;resize:vertical;min-height:60px;font-family:monospace"></textarea>
          <div style="font-size:10px;color:var(--text-muted);padding:2px 0">Required: Service account with roles/viewer</div>
        </div>
      </div>

      <!-- On-premise network -->
      <div id="cd-network-card" style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:16px">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
          <div style="width:32px;height:32px;background:rgba(99,102,241,0.1);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px">📡</div>
          <div style="flex:1"><div style="font-size:13px;font-weight:700;color:var(--text-primary)">On-Premise Network</div>
          <div style="font-size:11px;color:var(--text-muted)">Local LLMs · DICOM · HL7 · AI servers</div></div>
