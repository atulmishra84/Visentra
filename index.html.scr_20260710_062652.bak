              <input id="cd-sf-client" placeholder="Connected App Client ID" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <input id="cd-sf-secret" type="password" placeholder="Connected App Client Secret" style="font-size:11px;padding:6px 8px;border-radius:6px;border:1px solid var(--glass-border-dim);background:var(--bg-primary);color:var(--text-primary);width:100%;box-sizing:border-box">
              <div style="font-size:10px;color:var(--text-muted)">Needs: api · refresh_token scope</div>
            </div>
          </div>
        </div>

        <!-- SaaS AI Platforms row 2: Workday + Oracle Cloud -->
        <div class="g2">
          <!-- Workday -->
          <div style="background:var(--glass-white);border:1px solid var(--glass-border-dim);border-radius:12px;padding:14px">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
              <div style="width:28px;height:28px;background:rgba(247,148,30,0.1);border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:14px">📊</div>
              <div style="flex:1"><div style="font-size:12px;font-weight:700">Workday</div><div style="font-size:10px;color:var(--text-muted)">Workday AI · Skills Cloud · Assist</div></div>
              <div id="cd-workday-status" style="font-size:10px;padding:2px 6px;border-radius:10px;background:var(--bg-secondary);color:var(--text-muted)">Off</div>
