                <div class="cred-field"><div class="cred-lbl">SSH Username</div><input class="cred-inp" id="ci-ssh-user" placeholder="agentRadar-scanner"></div>
                <div class="cred-field"><div class="cred-lbl">Private Key (PEM)</div><input class="cred-inp" id="ci-ssh-key" type="password" placeholder="-----BEGIN RSA PRIVATE KEY-----"></div>
              </div>
              <div class="code-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm"># Create read-only scan user on target hosts</span>
useradd -r -s /sbin/nologin agentRadar-scanner
<span class="cm"># Commands the scanner runs (read-only):</span>
<span class="kw">ps aux</span>  <span class="cm"># list processes</span>
<span class="kw">ss -tlnp</span>  <span class="cm"># list listening ports</span>
<span class="kw">cat /proc/net/tcp</span>  <span class="cm"># network connections</span></div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('ssh')">▶ Test SSH</button>
