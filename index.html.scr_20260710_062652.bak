              <div><div class="conn-name">Splunk</div><div style="font-size:10px;color:var(--text-muted)">Enterprise · Cloud · ITSI</div></div>
              <span class="conn-status cs-connected" id="cs-splunk">Connected</span>
              <div class="conn-expand">+</div>
            </div>
            <div class="conn-body">
              <div class="cred-grid">
                <div class="cred-field full"><div class="cred-lbl">Splunk REST API URL</div><input class="cred-inp" id="ci-splunk-url" placeholder="https://splunk.corp.com:8089" value="https://splunk.healthsys.org:8089"></div>
                <div class="cred-field"><div class="cred-lbl">HEC Token (read-only)</div><input class="cred-inp" id="ci-splunk-token" type="password" value="set" placeholder="Splunk-xxxxxxxx-xxxx"></div>
                <div class="cred-field"><div class="cred-lbl">Indexes to search</div><input class="cred-inp" id="ci-splunk-idx" value="main, security, _internal" placeholder="main, security"></div>
                <div class="cred-field"><div class="cred-lbl">Lookback window</div><select class="cred-select" id="ci-splunk-window"><option>7 days</option><option selected>30 days</option><option>90 days</option></select></div>
              </div>
              <div class="code-snip" id="splunk-query-snip"><button class="snip-copy" onclick="copySnip(this)">Copy</button><span class="cm">| AgentRadar shadow AI detection query</span>
index=* earliest=-30d (
  dest_host=<span class="str">"api.openai.com"</span> OR dest_host=<span class="str">"api.anthropic.com"</span>
  OR dest_host=<span class="str">"*.huggingface.co"</span>
  OR (dest_port=<span class="val">11434</span>) <span class="cm">/* Ollama */</span>
  OR (dest_port=<span class="val">2575</span>) <span class="cm">/* HL7 MLLP — shadow healthcare */</span>
  OR (dest_port=<span class="val">8899</span>) <span class="cm">/* Unknown shadow signal */</span>
) | stats count by src_ip, dest_host, dest_port, proc_name</div>
              <div class="cred-actions">
                <button class="btn sm primary" onclick="testConn('splunk')">▶ Test</button>
                <button class="btn sm" onclick="runSiemScan('splunk')">Run Query</button>
              </div>
