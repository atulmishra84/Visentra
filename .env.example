# AgentRadar — Environment Template (no secrets)
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.example.com

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentradar
POSTGRES_USER=agentradar
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Auth / crypto
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=true

# Bootstrap admin (created on first migrate if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_NAME=Platform Admin

# Azure discovery (optional — demo mode without credentials)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
DISCOVERY_INTERVAL_MS=3600000
DISCOVERY_DEMO_MODE=true

# Azure Monitor / Log Analytics (SIEM forwarding)
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_KEY=

# Azure SSO (optional)
AZURE_SSO_CLIENT_ID=
AZURE_SSO_CLIENT_SECRET=
