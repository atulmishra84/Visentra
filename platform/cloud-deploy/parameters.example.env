# Copy to parameters.env and export before ./install.sh --yes
#   set -a; source parameters.env; set +a; ./install.sh --yes

SUBSCRIPTION_ID=
RG=rg-agentradar
LOCATION=eastus
PREFIX=agentradar

BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# Leave blank to auto-generate a strong password (printed once at the end)
BOOTSTRAP_ADMIN_PASSWORD=

# Optional — auto-generated when empty
# JWT_SECRET=
# ENCRYPTION_KEY=
# POSTGRES_PASSWORD=

SEED_ON_START=false
ALLOW_DEMO_SEED=false
