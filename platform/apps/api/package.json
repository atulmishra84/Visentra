{
  "name": "@agentradar/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "validate:env": "node -e \"import('./src/config.js').then(m=>m.assertProductionConfig()).then(()=>console.log('ok')).catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "neo4j-driver": "^5.27.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  }
}
