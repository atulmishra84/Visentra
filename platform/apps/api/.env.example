# Visentra API — environment template
# Copy to .env and fill values. Never commit real secrets.

NODE_ENV=production
PORT=8080

# Required
POSTGRES_URL=postgres://agentradar:CHANGE_ME@postgres:5432/agentradar
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
CORS_ORIGIN=https://your-web-hostname.example.com
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_strong_password

# Optional Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Bootstrap tenant (production defaults)
BOOTSTRAP_TENANT_NAME=Enterprise
BOOTSTRAP_TENANT_SLUG=enterprise

# JWT lifetime (default 8h in production)
JWT_TTL=8h

# Optional
REDIS_URL=redis://redis:6379
AZURE_DISCOVERY_MAX_RESOURCES=500
EDR_DISCOVERY_MAX_DEVICES=100
