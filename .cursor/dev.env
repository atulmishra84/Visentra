# Local / Cloud Agent dev environment variables for the Visentra platform.
# These are non-production development defaults (mirroring platform/infra/compose/docker-compose.yml).
# Do NOT use these values in production.
POSTGRES_URL=postgres://agentradar:agentradar@localhost:5432/agentradar
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentradar
JWT_SECRET=agentradar-dev-secret-change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BOOTSTRAP_ADMIN_EMAIL=admin@agentradar.local
BOOTSTRAP_ADMIN_PASSWORD=AgentRadar!dev
DISCOVERY_DEMO_SEED=false
DISCOVERY_AI_ONLY=true
NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
API_INTERNAL_URL=http://localhost:8080
DISCOVERY_INTERVAL_MS=300000
RUN_ON_START=true
RELATIONSHIP_DECAY_INTERVAL_MS=3600000
